{
  "openapi": "3.0.1",
  "info": {
    "title": "SGA - Plantillas Word API",
    "description": "API monolítica educativa para gestión de plantillas Word y llenado de documentos.",
    "version": "v1"
  },
  "paths": {
    "/api/Plantillas": {
      "post": {
        "tags": [
          "Plantillas"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CrearPlantillaRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CrearPlantillaRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CrearPlantillaRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlantillaResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/Plantillas/importar-docx": {
      "post": {
        "tags": [
          "Plantillas"
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "required": [
                  "Archivo",
                  "CreadoPorUsuarioId",
                  "EstadoPlantillaId"
                ],
                "type": "object",
                "properties": {
                  "Archivo": {
                    "type": "string",
                    "format": "binary"
                  },
                  "EstadoPlantillaId": {
                    "maximum": 2147483647,
                    "minimum": 1,
                    "type": "integer",
                    "format": "int32"
                  },
                  "CreadoPorUsuarioId": {
                    "maximum": 2147483647,
                    "minimum": 1,
                    "type": "integer",
                    "format": "int32"
                  },
                  "Descripcion": {
                    "maxLength": 500,
                    "type": "string"
                  }
                }
              },
              "encoding": {
                "Archivo": {
                  "style": "form"
                },
                "EstadoPlantillaId": {
                  "style": "form"
                },
                "CreadoPorUsuarioId": {
                  "style": "form"
                },
                "Descripcion": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportarPlantillaResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CampoDetectadoDto": {
        "type": "object",
        "properties": {
          "fieldKey": {
            "type": "string",
            "nullable": true
          },
          "displayLabel": {
            "type": "string",
            "nullable": true
          },
          "orden": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "CrearPlantillaRequest": {
        "required": [
          "creadoPorUsuarioId",
          "estadoPlantillaId",
          "nombre"
        ],
        "type": "object",
        "properties": {
          "nombre": {
            "maxLength": 180,
            "minLength": 1,
            "type": "string"
          },
          "descripcion": {
            "maxLength": 500,
            "type": "string",
            "nullable": true
          },
          "estadoPlantillaId": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "creadoPorUsuarioId": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "traceId": {
            "type": "string",
            "nullable": true
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "nullable": true
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ImportarPlantillaResponse": {
        "type": "object",
        "properties": {
          "plantillaId": {
            "type": "integer",
            "format": "int32"
          },
          "nombre": {
            "type": "string",
            "nullable": true
          },
          "descripcion": {
            "type": "string",
            "nullable": true
          },
          "estadoPlantillaId": {
            "type": "integer",
            "format": "int32"
          },
          "creadoPorUsuarioId": {
            "type": "integer",
            "format": "int32"
          },
          "storagePath": {
            "type": "string",
            "nullable": true
          },
          "camposDetectados": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CampoDetectadoDto"
            },
            "nullable": true
          },
          "fechaCreacion": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "PlantillaResponse": {
        "type": "object",
        "properties": {
          "plantillaId": {
            "type": "integer",
            "format": "int32"
          },
          "nombre": {
            "type": "string",
            "nullable": true
          },
          "descripcion": {
            "type": "string",
            "nullable": true
          },
          "estadoPlantillaId": {
            "type": "integer",
            "format": "int32"
          },
          "creadoPorUsuarioId": {
            "type": "integer",
            "format": "int32"
          },
          "storagePath": {
            "type": "string",
            "nullable": true
          },
          "fechaCreacion": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    }
  }
}